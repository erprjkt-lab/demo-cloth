# Local: postgresql://postgres:PASSWORD@localhost:5432/job_challan
# Neon: pooled string for DATABASE_URL, direct string for DIRECT_URL
# Hosted databases (Neon, Prisma Postgres): add &connect_timeout=30&pool_timeout=30 so a slow
# connection waits instead of failing with "Can't reach database server".
# Schema changes: npx prisma db push (no migrations folder yet).
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/job_challan"
DIRECT_URL="postgresql://postgres:PASSWORD@localhost:5432/job_challan"

# Docker Compose only (docker-compose.yml builds the DB URL from these; DATABASE_URL above is ignored there).
# Defaults use the bundled Postgres container. For an external server set POSTGRES_HOST to its
# hostname (e.g. db.some.co), plus its port, database name and POSTGRES_SSLMODE="require".
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="job_challan"
POSTGRES_HOST="db"
POSTGRES_PORT="5432"
POSTGRES_SSLMODE="disable"
# Host port the bundled Postgres container is published on
DB_PORT="5432"
# Host port the app is published on
APP_PORT="3000"
# Set to "true" once the app is served over HTTPS
COOKIE_SECURE="false"

# At least 32 random characters
SESSION_SECRET=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""

# Web push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Shared secret for /api/cron/reminders
CRON_SECRET=""
